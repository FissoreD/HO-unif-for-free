internal-test comp.test-maybe-eta.

typeabbrev (memory A) (mem.memory A).
typeabbrev addr mem.addr.
typeabbrev addr mem.addr.

namespace comp {
  shorten fo.{ (==o), olam, oapp, ocon, ouva , eta-contract , beta, beta-normal }.
  shorten ho.{ (==l), mlam, mapp, mcon, muva , abs , val , deref-assmt }.
  shorten mem.{ set? , unset? , assign }.
  typeabbrev otm fo.otm.
  typeabbrev mtm ho.mtm.
  typeabbrev subst ho.subst.
  typeabbrev fsubst fo.fsubst.

%BEGIN
  typeabbrev arity nat.
  % type arity nat -> arity.
%SNIP: comp_base_types
  kind ovariable type.
  type ovar addr -> ovariable.
  kind mvariable type.
  type mvar addr -> arity -> mvariable.
  kind mapping type.
  type (<->) ovariable -> mvariable -> mapping.
  typeabbrev mmap (list mapping).
%ENDSNIP

  typeabbrev scope (list mtm).
  typeabbrev (inctx A) (ho.inctx A).
%SNIP: comp_links
  kind baselink type.
  type (>=eta)  mtm -> mtm -> baselink.
  type (>=llam) mtm -> mtm -> baselink.
  typeabbrev links (list (inctx baselink)).
%ENDSNIP
  typeabbrev link (inctx baselink).

  macro @val-link-eta T1 T2 :- ho.val (T1 >=eta T2).
  macro @val-link-llam T1 T2 :- ho.val (T1 >=llam T2).


  type get-lhs link -> mtm -> o.
  get-lhs (val (A >=llam _)) A.
  get-lhs (val (A >=eta _)) A.

  type get-rhs link -> mtm -> o.
  get-rhs (val (_ >=llam A)) A.
  get-rhs (val (_ >=eta A)) A.

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% COMPILER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%SNIP: maybe_eta
  % a term use a binder B if there exists a sub-term which `surely` reduce otm B
  % for example: `f (g x) a` use the binder x
  %       while: `f (A x) a` may not use x, since A can reduce otm a constant
  type occurs-rigidly otm -> otm -> o.
  occurs-rigidly N N.
  occurs-rigidly _ (oapp [ouva _|_]) :- !, fail.
  occurs-rigidly N (oapp L) :- exists (occurs-rigidly N) L.
  occurs-rigidly N (olam B) :- pi x\ occurs-rigidly N (B x).

  % [reducible-otm L N T] it ∃𝜎, 𝜎t = n
  type reducible-otm list otm -> otm -> otm -> o.
  reducible-otm _ N N :- !.
  reducible-otm L N (oapp[ouva _|Args]) :- !, 
    % Head is flex -> if N is in Args, we can have eta
    forall1 (x\ exists (reducible-otm [] x) Args) [N|L]. 
  reducible-otm L N (olam B) :- !, 
    pi x\ reducible-otm [x | L] N (B x).
  reducible-otm L N (oapp [N|Args]) :-
    % Head is rigid -> otm be an eta we consider also L
    last-n {len L} Args R,
    forall2 (reducible-otm []) R {rev L}.

  % takes a name N a term T and a list of bound variables.
  % succeeds if T could be an eta expansion, possible cases:
  %  - T = muva seing N (N is also the last of L)
  %  - T = mapp L such that the last args of L are maybe-eta wrt L
  type maybe-eta otm -> list otm -> o.                  
  maybe-eta (oapp[ouva _|Args]) L :- !,
    % Head is flex -> if N is in Args, we can have eta 
    forall1 (x\ exists (reducible-otm [] x) Args) L, !. 
  maybe-eta (olam B) L :- !, pi x\ maybe-eta (B x) [x | L].
  maybe-eta (oapp [T|Args]) L :- (name T; T = ocon _),
    % Head is rigid -> otm be an eta we consider also L
    split-last-n {len L} Args First Last,
    % forall1 (x\ forall1 (y\ not (occurs-rigidly x y)) First) L,
    none (x\ exists (y\ occurs-rigidly x y) First) L,
    forall2 (reducible-otm []) {rev L} Last.
%ENDSNIP


  type locally-bound mtm -> o.
  type get-scope-aux mtm -> list mtm -> o.
  get-scope-aux (mcon _) [].
  get-scope-aux (muva _ L) L1 :- 
    map get-scope-aux L R,
    flatten R L1.
  get-scope-aux (mlam B) L1 :- 
    pi x\ locally-bound x => get-scope-aux (B x) L1.
  get-scope-aux (mapp L) L1 :- 
    map get-scope-aux L R,
    flatten R L1.
  get-scope-aux X [X] :- name X, not (locally-bound X).
  get-scope-aux X [] :- name X, (locally-bound X).

  type names1 list mtm -> o.
  names1 L :-
    names L1, 
    new_int N,
    if (1 is N mod 2) (L1 = L) (rev L1 L).

  type get-scope mtm -> list mtm -> o.
  get-scope T Scope :-
    get-scope-aux T ScopeDuplicata,
    undup ScopeDuplicata Scope.
  type rigid otm -> o.
  rigid X :- not (X = ouva _).

%SNIP: comp_lam
  pred comp-lam (otm -> otm), mmap, links, subst -> 
                (mtm -> mtm), mmap, links, subst.
  comp-lam F M1 L1 S1 G M2 L3 S2 :-
    pi x y\ (pi M L S\ comp x M L S y M L S) =>       
      comp (F x) M1 L1 S1 (G y) M2 (L2 y) S2,
    close-links L2 L3.
%ENDSNIP

%SNIP: comp_close_links
  pred close-links (mtm -> links) -> links.
  % close-links (v\[X  |L v]) [X|R] :- !, close-links L R.
  close-links (v\[X v|L v]) [abs X|R] :- close-links L R.
  close-links (_\[]) [].
%ENDSNIP
%SNIP: comp_base
  pred comp otm, mmap, links, subst -> 
            mtm, mmap, links, subst.
  comp (ocon C) M L S (mcon C) M L S.
%ENDSNIP
%SNIP: comp_eta
  comp (olam F) M1 L1 S1 (muva A Scope) M2 L3 S3 :-
    maybe-eta (olam F) [], !,
    alloc S1 A S2,
    comp-lam F M1 L1 S2 G M2 L2 S3,
    get-scope (mlam G) Scope, 
    L3 = [val (muva A Scope >=eta mlam G) | L2].
%ENDSNIP
%SNIP: comp_base
  comp (olam F) M1 L1 S1 (mlam G) M2 L2 S2 :-        % $r_\lambda$    
    comp-lam F M1 L1 S1 G M2 L2 S2.
  comp (ouva A) M1 L S1 (muva B []) M2 L S2 :- 
    m-alloc (ovar A) M1 S1 (mvar B z) M2 S2.
%ENDSNIP
%SNIP: comp_base_beta
  comp (oapp [ouva A|Ag]) M1 L S1 (muva B Ag1) M2 L S2 :-
    pattern-fragment Ag, !,
      fold6 comp Ag M1 L S1 Ag1 M1 L S1,
      len Ag Arity, 
      m-alloc (ovar A) M1 S1 (mvar B Arity) M2 S2.
%ENDSNIP
%SNIP: comp_beta
  comp (oapp [ouva A|Ag]) M1 L1 S1 (muva B Sc) M3 L3 S4 :- !,
    pattern-fragment-prefix Ag Pf Extra, alloc S1 B S2,
    len Pf Ar, m-alloc (ovar A) M1 S2 (mvar C Ar) M2 S3,
    fold6 comp Pf    M2 L1 S3 Pf1    M2 L1 S3,
    fold6 comp Extra M2 L1 S3 Extra1 M3 L2 S4,
    Beta = mapp [muva C Pf1 | Extra1],
    get-scope Beta Sc, 
    L3 = [val (muva B Sc >=llam Beta) | L2].
%ENDSNIP
%SNIP: comp_base
  comp (oapp A) M1 L1 S1 (mapp A1) M2 L2 S2 :-        % $r_@$ 
    fold6 comp A M1 L1 S1 A1 M2 L2 S2.
%ENDSNIP

  type alloc memory A -> addr -> memory A -> o.
  alloc S N S1 :- mem.new S N S1.

  pred compile-terms-diagnostic 
    triple diagnostic otm otm, mmap, links, subst ->
    triple diagnostic mtm mtm, mmap, links, subst.
  compile-terms-diagnostic (triple D FO1 FO2) M1 L1 S1 (triple D HO1 HO2) M3 L3 S3 :-
    beta-normal FO1 FO1',
    beta-normal FO2 FO2',
    comp FO1' M1 L1 S1 HO1 M2 L2 S2,
    comp FO2' M2 L2 S2 HO2 M3 L3 S3.

  type compile-terms int ->
    list (triple diagnostic otm otm) -> 
    list (triple diagnostic mtm mtm) -> 
    mmap -> links -> subst -> o.
  compile-terms N T H M L S :- 
    fold6 compile-terms-diagnostic T [] [] [] H M_ L_ S_,
    print-compil-result N T H L_ M_, 
    print "Deduplicate mappings on" {ppmappings M_} {pplinks L_}, % HIDE
    deduplicate-map M_ M S_ S L_ L.

  % Ad1 is the variable with smaller arity, Ad2 is eta expanded N times
  type make-eta-link-aux nat -> addr -> addr -> 
    list mtm -> links -> subst -> subst -> o.
  make-eta-link-aux z Ad1 Ad2 Scope1 L H1 H1  :-
    rev Scope1 Scope, eta-expand (muva Ad2 Scope) T1,
    L = [val (muva Ad1 Scope >=eta T1)].
  make-eta-link-aux (s N) Ad1 Ad2 Scope1 L H1 H3 :-
    rev Scope1 Scope, alloc H1 Ad H2, 
    eta-expand (muva Ad Scope) T2,
    (pi x\ make-eta-link-aux N Ad Ad2 [x|Scope1] (L1 x) H2 H3),
    close-links L1 L2,
    L = [val (muva Ad1 Scope >=eta T2) | L2].

  % [make-eta-link ArityAd1, ArityAd2, Ad1, Ad2 Vars, Link]
  % as long as the arities are > 0, we eat one arity by putting a variable in the ctx
  % in the base case we return the link-eta eta-extending N times the variable with higher arity.
  type make-eta-link nat -> nat -> addr -> addr -> 
          list mtm -> links -> subst -> subst -> o.
  make-eta-link (s N) z Ad1 Ad2 Vars L H H1 :- 
    make-eta-link-aux N Ad2 Ad1 Vars L H H1.
  make-eta-link z (s N) Ad1 Ad2 Vars L H H1 :- 
    make-eta-link-aux N Ad1 Ad2 Vars L H H1.
  make-eta-link (s N) (s M) Ad1 Ad2 Vars Links H H1 :-
    (pi x\ make-eta-link N M Ad1 Ad2 [x|Vars] (L x) H H1),
    close-links L Links.

  % if there exists two map on the form:
  %   ==> C0 -> X4 (2) ~!~ C0 -> X1 (1)
  % we remove one of the two map and add an eta relation between 
  % the two variables, so that they are fully applied.
  % in the example above, the new link will be 
  %   ==> c0 |- `X1 c0' =η= c1\ `X4 c0 c1'
  % where: 
  %  - they share a common variable from the context (i.e. c0),
  %  - X4 is the eta-expanded once otm be fully applied
  type deduplicate-map mmap -> mmap -> 
      subst -> subst -> links -> links -> o.
  deduplicate-map [] [] H H L L.
  deduplicate-map [((ovar O <-> mvar M LenM) as X1) | Map1] Map2 H1 H3 L1 L3 :-
    take-list Map1 ((ovar O <-> mvar M' LenM')) _, !,
    std.assert! (not (LenM = LenM')) "Deduplicate map, there is a bug",
    print "arity-fix links:" {ppmapping X1} "~!~" {ppmapping ((ovar O <-> mvar M' LenM'))}, 
    make-eta-link LenM LenM' M M' [] New H1 H2,
    print "new eta link" {pplinks New},
    append New L1 L2,
    deduplicate-map Map1 Map2 H2 H3 L2 L3.
  deduplicate-map [A|As] [A|Bs] H1 H2 L1 L2 :- 
    deduplicate-map As Bs H1 H2 L1 L2, !.
  deduplicate-map [A|_] _ H _ _ _ :- 
    halt "deduplicating mapping error" {ppmapping A} {ho.ppsubst H}.
%END

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% AUXILIARY %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  type mk-mapp mtm -> mtm -> mtm -> o.
  mk-mapp (muva N L) T (muva N R) :- append L [T] R.
  mk-mapp (mcon C) T (mapp [mcon C, T]).
  mk-mapp (mapp L) T (mapp R) :- append L [T] R.
  mk-mapp T L (mapp [T, L]) :- name T.

  type eta-expand-n mtm -> nat -> mtm -> o.
  eta-expand-n T z T.
  eta-expand-n T (s N) (mlam R2) :- 
    pi x\ mk-mapp T x (R1 x), eta-expand-n (R1 x) N (R2 x). 

  type eta-expand mtm -> mtm -> o.
  eta-expand T (mlam T') :- pi x\ mk-mapp T x (T' x). 


%SNIP: alloc_mapping
  pred m-alloc ovariable, mmap, subst -> mvariable, mmap, subst.
  m-alloc Ov M S Mv M S :- mem M (Ov <-> Mv), !.
  m-alloc Ov M S Mv [Ov <-> Mv|M] S1 :- Mv = mvar N _, new S N S1.
%ENDSNIP

type new  memory A -> addr -> memory A -> o.
new A B C :- mem.new A B C.

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% PROGRESS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  macro @one :- s z.

  type occurs-rigidly-ho mtm -> mtm -> o.
  occurs-rigidly-ho N N.
  occurs-rigidly-ho _ (muva _ _) :- !, fail.
  occurs-rigidly-ho N (mapp L) :- exists (occurs-rigidly-ho N) L.
  occurs-rigidly-ho N (mlam B) :- pi x\ occurs-rigidly-ho N (B x).

  type reducible-otm-ho list mtm -> mtm -> mtm -> o.
  reducible-otm-ho _ N N :- !.
  reducible-otm-ho L N (muva _ Args) :- !, forall1 (mem Args) [N|L]. 
  reducible-otm-ho L N (mlam B) :- !, pi x\ reducible-otm-ho [x | L] N (B x).
  reducible-otm-ho L N (mapp [N|Args]) :- last-n {len L} Args R,
    forall2 (reducible-otm-ho []) R {rev L}.

  type maybe-eta-ho mtm -> list mtm -> o.
  maybe-eta-ho (muva _ Args) L :- !, forall1 (mem Args) L, !. 
  maybe-eta-ho (mlam B) L :- !, pi x\ maybe-eta-ho (B x) [x | L].
  maybe-eta-ho (mapp [T|Args]) L :- (T = mcon _; name T),
    split-last-n {len L} Args First Last,
    none (x\ exists (occurs-rigidly-ho x) First) L,
    forall2 (reducible-otm-ho []) {rev L} Last.

  type close-term mtm -> list mtm -> mtm -> o.
  close-term T [] T' :- (pi x\ ho.copy x x :- name x) => ho.copy T T'.
  close-term T [X|Xs] (mlam T') :- pi x\ ho.copy X x => close-term T Xs (T' x).

  % if there exists a subst s such that contract-rigid st t', then
  % maybe-eta t must succeed
  type contract-rigid list mtm -> mtm -> mtm -> o.
  contract-rigid L (mlam F) T :- !,
    pi x\ contract-rigid [x|L] (F x) T. % also checks H Prefix does not see x
  contract-rigid L (mapp [H|Args]) T :-
    rev L LRev, append Prefix LRev Args,
    if (Prefix = []) (T = H) (T = mapp [H|Prefix]).
  contract-rigid L T T' :- not (maybe-eta-ho T L), !, print "It is not a maybe-eta", 
    close-term T {std.rev L} T'.

  % invariante: a sx non c'è mai una eta espansione, a destra c'è una mlam, altrimenti il link eta è buttato via
  type progress-eta-link mtm -> mtm -> subst -> subst -> links -> o.
  progress-eta-link (mapp _ as T) (mlam x\ _ as T1) H H1 [] :- !, 
    print "progress η mapp left", % HIDE
    ({eta-expand T} ==l T1) H H1.
  progress-eta-link (mcon _ as T) (mlam x\ _ as T1) H H1 [] :- !, 
    print "progress η mcon left", % HIDE
    ({eta-expand T} ==l T1) H H1.
  progress-eta-link T (mlam x\ _ as T1) H H1 [] :- name T, !, 
    print "progress η name left", % HIDE
    ({eta-expand T} ==l T1) H H1.
  progress-eta-link (mlam _ as T) T1 H H1 [] :- !, 
    print "progress η mlam left", % HIDE 
    (T ==l T1) H H1.
  progress-eta-link (muva _ _ as X) T H H1 [] :- 
    contract-rigid [] T T1, !, 
    print "progress η right", % HIDE
    (X ==l T1) H H1.
  progress-eta-link T1 T2 H H [val (T1 >=eta T2)].

  type is-in-pf mtm -> o.
  is-in-pf uvar :- halt "passed var otm is-in-pf".
  is-in-pf (mapp [muva _ _ | _]) :- !, fail.
  is-in-pf (mlam B) :- !, pi x\ is-in-pf (B x).
  is-in-pf (mcon _).
  is-in-pf (mapp L) :- forall1 is-in-pf L.
  is-in-pf N :- name N.
  is-in-pf (muva _ L) :- pattern-fragment L.

  type progress-beta-llambda list mtm -> mtm -> mtm -> subst -> subst -> links -> o.
  progress-beta-llambda [] T1 T2 S1 S2 [] :- !,
    (T1 ==l T2) S1 S2.
  progress-beta-llambda Ag T1 T2 S S [L] :-
    L = val (T1 >=llam mapp [T2|Ag]).

  type suspend-out-of-mlam o.
  type progress-beta-force o.

%SNIP: progress_heuristic
  type mapp-align-heuristic mtm -> mtm -> subst -> subst -> o.
  mapp-align-heuristic (mapp [HD|L1]) (mapp [UV|L2]) S1 S2 :-
    print "Unification align heuristics", % HIDE
    append Prefix L2 L1,
    !, % HIDE
    ho.beta HD Prefix T,
    print "End unif heuristic", %HIDE
    (UV ==l T) S1 S2.
%ENDSNIP
  mapp-align-heuristic (mapp [HD|L1]) (mapp [UV|L2]) S1 S2 :-
    print "Unification align heuristics", % HIDE
    append Prefix L1 L2,
    !, % HIDE
    ho.beta UV Prefix T,
    print "End unif heuristic", %HIDE
    (T ==l HD) S1 S2. % XXX this time  T is not in llam
  % progress-out-llambda LHS V_RHS AG_RHS S1 S2 L % Note AG_RHS is non-empty, otherwise we are in llambda
  type progress-out-llambda mtm -> mtm -> subst -> subst -> links -> o.
  progress-out-llambda T1 T2 S S [val(T1 >=llam T2)] :- suspend-out-of-mlam, !,
    print "Unification out of Lλ delayed".
  progress-out-llambda _ _ _ _ _ :- print "Unif out llambda: fail", fail.

  % a sx non c'è mai un mapp[muva _ _ | _] per costruzione
  % a dx abbiamo sempre mapp[muva _ N | L] dove N è nel PF e L no
  type progress-beta-link mtm -> mtm -> subst -> subst -> links -> o.
  % progress-beta-link T (mapp[muva V Scope | L] as T2) S S2 [@val-link-llam T T2] :- 
  %   arity T Arity, len L ArgsNb, ArgsNb >n Arity, !,
  %   minus ArgsNb Arity Diff, alloc S V1 S1,
  %   eta-expand (muva V1 Scope) Diff T1,
  %   (muva V Scope ==l T1) S1 S2,
  %   print "progress β big arity" {ho.pp T} "unified with" {ho.pp T1} "->" {ho.ppsubst S2}.

  % this is for beta links of the form `>=llam T (mapp[muva N [], mapp[B, x] | ...])
  % and B is instantiated otm (x\x)
  % In this case, the terms on the right becomes (mapp[muva N [], x | L])
  % We want otm put the name x in the scope of N otm make HO unif, therefore, we
  % build a new var N' of arity 1, eta-linked otm N and the beta links is updated
  % New links will be: [>=llam T (mapp[muva N' [x] | L]), link-eta N (λx.muva N' [x])]

  progress-beta-link T (mapp[muva Ad1 Scope1 | [HD|TL]]) S1 S4 NewLinks :-
    append Scope1 [HD] Scope2,
    pattern-fragment Scope2, !,
    alloc S1 Ad2 S2,
    LinkEta = val (muva Ad1 Scope1 >=eta {eta-expand (muva Ad2 Scope1)}),
    progress-beta-llambda TL T (muva Ad2 Scope2) S2 S4 L,
    NewLinks = [LinkEta | L].

  progress-beta-link T1 T2 S1 S2 [] :- T2 = mapp[muva _ _|_], not (T1 = muva _ _), progress-beta-force, !,
    mapp-align-heuristic T1 T2 S1 S2.

  progress-beta-link T1 T2 S1 S2 L :- T2 = mapp[muva _ _|_], not (T1 = muva _ _), suspend-out-of-mlam, !,
    progress-out-llambda T1 T2 S1 S2 L.

  progress-beta-link (mapp [A|_]) (mapp[muva _ _|_]) _ _ _ :-
    not (A = muva _ _), !, fail.

  progress-beta-link T1 (mapp[muva _ _ | _] as T2) H H [@val-link-llam T1 T2] :- !, print "No β progress1".

  progress-beta-link T1 (mapp [Hd | MS]) S1 S2 [] :- % Hd is rigid!
    ho.beta Hd MS T3, is-in-pf T3, !, 
    print "Progress β deep with" {ho.pp T3}, % HIDE
    (T1 ==l T3) S1 S2.

  progress-beta-link _ (muva _ _) _ _ _ :- !, halt "progress beta-link: invariant broken". 

  progress-beta-link T1 T2 S S [val (T1 >=llam T2)] :- !, print "no progress β".

  type solve-link-abs link -> links -> list mtm -> subst -> subst -> o.
  solve-link-abs (ho.abs X) R L H H1 :- 
    (pi x\ solve-link-abs (X x) (R' x) [x|L] H H1),
    close-links R' R.

  solve-link-abs (@val-link-eta A B) NewLinks _ S S1 :- !,
    print "In progress eta link for" {ho.pp A} {ho.pp B}, %HIDE
    progress-eta-link A B S S1 NewLinks,
    if (NewLinks = []) (print "After progress the subst is" {ho.ppsubst S1}) (print "No progress").

  solve-link-abs (@val-link-llam A B) NewLinks _ S S1 :- !,
    print "In progress beta link for" {ho.pp A} {ho.pp B} "in" {ho.ppsubst S}, %HIDE
    progress-beta-link A B S S1 NewLinks.

  type take-link link -> links -> link -> links -> o.
  take-link A [B|XS] B XS :- link-abs-same-lhs A B, !.
  take-link A [L|XS] B [L|YS] :- take-link A XS B YS.

  type link-abs-same-lhs link -> link -> o.
  link-abs-same-lhs (ho.abs F) B :- 
    pi x\ link-abs-same-lhs (F x) B.
  link-abs-same-lhs A (ho.abs G) :- 
    pi x\ link-abs-same-lhs A (G x).
  link-abs-same-lhs (val (muva N _ >=eta _)) (val (muva N _ >=eta _)) :- !.
  link-abs-same-lhs _ _ :- suspend-out-of-mlam, !, fail.
  link-abs-same-lhs A B :-
    get-lhs A (muva N _),
    get-lhs B (muva N _), !.

  type same-link link -> link -> subst -> subst -> o.
  % same-link (ho.abs F) (ho.abs G) H H1 :- !, pi x\ same-link (F x) (G x) H H1.
  same-link (ho.abs F) G H H1 :- !, pi x\ same-link (F x) G H H1.
  same-link A (ho.abs G) H H1 :- !, pi x\ same-link A (G x) H H1.
  same-link (val (muva N S1 >=eta A))
                (val (muva N S2 >=eta B)) H H1 :- !,
    std.assert! (std.length S1 {std.length S2}) "no same scope", % HIDE
    forall3 (x\y\r\ r = ho.copy x y) S1 S2 Perm,
    Perm => ho.copy A A',
    (A' ==l B) H H1.
  same-link L1 L2 H H1 :-
    get-lhs L1 (muva N S1), get-rhs L1 A,
    get-lhs L2 (muva N S2), get-rhs L2 B,
    std.assert! (std.length S1 {std.length S2}) "no same scope", % HIDE
    forall3 (x\y\r\ r = ho.copy x y) S1 S2 Perm,
    Perm => ho.copy A A',
    if (progress-beta-force) ((A' ==l B) H H1) (A' = B, H = H1).

%SNIP: progress1
  type progress1 links -> links -> subst -> subst -> o.
%ENDSNIP

%SNIP: progress1
  progress1 [] [] X X.
  progress1 [A|L1] [A|L3] S S2 :- take-link A L1 B L2, !,
    print "deduplicating links:" {pplink A} "===" {pplink B}, % HIDE
    same-link A B S S1, 
    progress1 L2 L3 S1 S2.
  progress1 [L0|L1] L3 S S2 :-
    print "considering link for progress:" {pplink L0}, % HIDE
    solve-link-abs L0 R [] S S1, !,
    if (R = []) (print {pplink L0} "is removed") true, % HIDE
    progress1 L1 L2 S1 S2, append R L2 L3.
%ENDSNIP

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% OCC CHECK %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  type get-head-link link -> addr -> mtm -> o.
  get-head-link (@val-link-eta (muva Ad _) T) Ad T :- !.
  get-head-link (@val-link-llam (muva Ad _) T) Ad T :- !.
  get-head-link (ho.abs B) Ad (mlam T) :- !, pi x\ get-head-link (B x) Ad (T x).
  get-head-link Link _ _ :- print "get-head-link: attention not in PF" {pplink Link} /*,halt*/, fail.

  type find-link-by-var addr -> links -> links -> list mtm -> list links -> o.
  find-link-by-var _ _ [] [] [].
  find-link-by-var Ad Prefix [Hd | L1] [T | L2] [Hd1|LL] :-
    append Prefix L1 Hd1,
    get-head-link Hd Ad1 T, Ad = Ad1, !,
    find-link-by-var Ad1 [Hd|Prefix] L1 L2 LL.
  find-link-by-var Ad Prefix [Hd | L1] L2 LL :- !,
    find-link-by-var Ad [Hd | Prefix] L1 L2 LL.

  type not_occ_links_aux addr -> links -> mtm -> o.
  not_occ_links_aux Ad _ (muva Ad _) :- !, fail.
  not_occ_links_aux Ad L (muva Ad1 _) :- !, 
    find-link-by-var Ad1 [] L Terms Links,
    forall2 (not_occ_links_aux Ad) Links Terms.
  not_occ_links_aux _ _ (mcon _) :- !.
  not_occ_links_aux _ _ N :- name N, !.
  not_occ_links_aux Ad L (mlam B) :- !, pi x\ not_occ_links_aux Ad L (B x).
  not_occ_links_aux Ad L (mapp B) :- !, forall1 (not_occ_links_aux Ad L) B.

  type not_occ_links addr -> mtm -> links -> o.
  not_occ_links _ (mcon _) _.
  not_occ_links Ad (mlam B) L :- pi x\ not_occ_links Ad (B x) L.
  not_occ_links Ad (muva Ad _) _ :- !.
  not_occ_links Ad1 (muva Ad2 _) L :- 
    find-link-by-var Ad2 [] L Terms Links,
    forall2 (not_occ_links_aux Ad1) Links Terms.
  not_occ_links Ad (mapp L) Links :-
    not_occ_links_aux Ad Links (mapp L).
  not_occ_links _ N _ :- name N.

  type occur-check-links links -> o.
  occur-check-links [].
  occur-check-links [Hd | MS] :-
    get-head-link Hd Ad Term, !,
    not_occ_links Ad Term MS,
    occur-check-links MS.
  occur-check-links [_|MS] :-
    print "OC is partial: a term is not in PF"
    occur-check-links MS.

  pred scope-check-aux list mtm, link, subst -> link, subst.
  scope-check-aux L (abs A) S NL S1 :- % This removes an abs when not needed: NL does not use x
    (pi x\ scope-check-aux L (A x) S NL S1), !.
  scope-check-aux L (abs A) S (abs NL) S1 :- !,
    (pi x\ scope-check-aux [x|L] (A x) S (NL x) S1).
  scope-check-aux L (val (muva V Sc >=eta R)) S1 (val (muva V Sc >=eta R')) S3 :-
    exists (not-in Sc) L, !,
    print "scope-check for >=eta" {pplink (val (muva V Sc >=eta R))}, % HIDE
    new S1 U S2, eta-expand (muva U Sc) R',
    (R' ==l R) S2 S3.
  scope-check-aux L (val (muva V Sc >=llam R)) S1 (val (muva V Sc >=llam R')) S3 :-
    exists (not-in Sc) L, !,
    print "scope-check for >=llam" {pplink (val (muva V Sc >=llam R))}, % HIDE
    new S1 U S2, (muva U Sc) = R',
    (R' ==l R) S2 S3.
  scope-check-aux _ A S A S.

  type scope-check links -> links -> subst -> subst -> o.
  scope-check L1 L2 S1 S2 :-
    fold2 (scope-check-aux []) L1 S1 L2 S2.

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% CHECK %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  :index(_ 1)
  type deref-links subst -> links -> links -> o.
  deref-links H L1 L2 :- map (deref-link H) L1 L2, !.
  deref-links _ _ _ :- halt "Bug in deref links". % HIDE

  type deref-link subst -> link -> link -> o.
  deref-link H (ho.abs F) (ho.abs G) :- pi x\ deref-link H (F x) (G x).
  deref-link H (@val-link-eta A B) (@val-link-eta A1 B1) :- ho.deref H A A1, ho.deref H B B1.
  deref-link H (@val-link-llam A B) (@val-link-llam A1 B1) :- ho.deref H A A1, ho.deref H B B1.

%SNIP: progress
  pred progress links, subst -> links, subst.
%ENDSNIP
  progress L0 S L1 S1 :- % unessential, could be inlined
    deref-links S L0 L,
    not (L0 = L),
    !,
    progress L S L1 S1.
%SNIP: progress
  progress L S L3 S3 :-
    print "\nfixpoint iteration on:" {pplinks L}, !, % HIDE
    progress1 L L1 S S1,
    !, % HIDE
    if ( % HIDE
    occur-check-links L1,
    true) true (print "fail by oc in progress", fail), % HIDE
    !, % HIDE
    print "Start scope check", % HIDE
    if ( % HIDE
    scope-check L1 L2 S1 S2
    ) (print "Scope check ok") (print "Scope check ko", fail), %HIDE
    if (L = L2, S = S2) (L3 = L2, S3 = S2)
       (progress L2 S2 L3 S3).
%ENDSNIP

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DECOMPL %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  type abs->mlam ho.assignment -> mtm -> o.
  abs->mlam (ho.abs T) (mlam R)  :- !, pi x\ abs->mlam (T x) (R x).
  abs->mlam (ho.val A) A.

  type commit-links-aux link -> subst -> subst -> o.
  commit-links-aux (@val-link-eta T1 T2) H1 H2 :- 
    ho.deref H1 T1 T1', ho.deref H1 T2 T2',
    print "Start decompl-η of" {ho.pp T1'} "and" {ho.pp T2'} "in" {ho.ppsubst H1}, !,
    (T1' ==l T2') H1 H2.
  commit-links-aux (@val-link-llam T1 T2) H1 H2 :- 
    ho.deref H1 T1 T1', ho.deref H1 T2 T2',
    print "Start decompl-β of" {ho.pp T1'} "and" {ho.pp T2'}, !,
    (T1' ==l T2') H1 H2.
  commit-links-aux (ho.abs B) H H1 :-
    pi x\ commit-links-aux (B x) H H1.

  type commit-links links -> subst -> subst -> o.
  commit-links [] H H.
  commit-links [Abs | Links] H H2 :- 
    commit-links-aux Abs H H1, !, 
    commit-links Links H1 H2.

%SNIP: decompm
  % Invariant: links are only on the form (link VO VM Arity), each VO appears once and each VM appears once
  type decompm mmap -> mmap -> subst -> fsubst -> fsubst -> o.
  decompm _ [A|_] _ _ _ :- print "Solving" {ppmapping A}, fail. % HIDE
  decompm _ [] _ F F.
  decompm M [ovar V <-> mvar H _|MS] S F1 F3 :- set? H S A,
    !, % HIDE
    print {ho.ppsubst S} {ho.ppass A}, % HIDE
    std.assert!( % HIDE
    deref-assmt S A A1,
    true) "Should not fail", % HIDE
    abs->mlam A1 T, decomp M T T1, 
    %eta-contract T1 T2, % "nice otm our users, not really needed"
    assign V F1 T1 F2,
    decompm M MS S F2 F3. 
  decompm M [_ <-> mvar H _|MS] S F1 F2 :- unset? H S,
    decompm M MS S F1 F2.
  decompm _ [L|_] S _ _ :- halt "Decompl mapping: failed on" {ppmapping L} {ho.ppsubst S}. % HIDE
%ENDSNIP

%SNIP: decomp
  type decomp mmap -> mtm -> otm -> o.
  decomp _ (mcon C)  (ocon C).
  decomp M (mapp A) (oapp B) :- map (decomp M) A B.
   % [H|Ag], beta H Ag R.
  decomp M (mlam F) (olam G) :- 
    pi x y\ (pi M\ decomp M x y) => decomp M (F x) (G y).
  decomp M (muva Mv Ag) R :-
    mem M (ovar Ov <-> mvar Mv _), 
    map (decomp M) Ag Bg,
    beta (ouva Ov) Bg R.
  decomp M H _ :- halt "Fail in decomp" {ppmappings M} {ho.pp H}. % HIDE
%ENDSNIP

  type add-new-map-aux subst -> list mtm -> mmap -> 
        mmap ->  fo.fsubst -> fo.fsubst -> o.
  add-new-map-aux _ [] _ [] S S.
  add-new-map-aux H [T|Ts] L L2 S S2 :- 
    add-new-map H T L L1 S S1, 
    add-new-map-aux H Ts L1 L2 S1 S2.

  type add-new-map subst -> mtm -> mmap -> 
      mmap ->  fo.fsubst -> fo.fsubst -> o.
  add-new-map _ (muva N _) Map [] F1 F1 :- 
    mem Map (_ <-> mvar N _), !.
  add-new-map H (muva N L) Map [Map1 | MapL] F1 F3 :-
    alloc F1 M F2,
    len L Arity, Map1 = (ovar M <-> mvar N Arity),
    add-new-map H (mapp L) [Map1 | Map] MapL F2 F3.
  add-new-map H (mlam B) Map NewMap F1 F2 :- 
    pi x\ add-new-map H (B x) Map NewMap F1 F2.
  add-new-map H (mapp L) Map NewMap F1 F3 :- 
    add-new-map-aux H L Map NewMap F1 F3.
  add-new-map _ (mcon _) _ [] F F :- !.
  add-new-map _ N _ [] F F :- name N.

  type complete-mapping-under-ass subst -> ho.assignment -> 
    mmap -> mmap ->  fo.fsubst -> fo.fsubst -> o.
  complete-mapping-under-ass H (ho.val Val) Map1 Map2 F1 F2 :- 
    add-new-map H Val Map1 Map2 F1 F2.
  complete-mapping-under-ass H (ho.abs Abs) Map1 Map2 F1 F2 :- 
    pi x\ complete-mapping-under-ass H (Abs x) Map1 Map2 F1 F2.

  type complete-mapping subst -> subst -> 
      mmap -> mmap -> fo.fsubst -> fo.fsubst -> o.
  complete-mapping _ [] L L F F.
  complete-mapping H [none | MS] L1 L2 F1 F2 :-   
    complete-mapping H MS L1 L2 F1 F2.
  complete-mapping H [some T0 | MS] L1 L3 F1 F3 :-
    ho.deref-assmt H T0 T,
    complete-mapping-under-ass H T L1 L2 F1 F2, 
    append L1 L2 LAll,
    complete-mapping H MS LAll L3 F2 F3.

%SNIP: decompile
  type decompile mmap -> links -> subst ->
    fsubst -> fsubst -> o.
  decompile M1 L S F1 F3 :- 
    % L1 conaints no link-eta (it may contain beta),
    commit-links L S S1,
    !, % HIDE                                                          
    print "# After decompl-eta, subst is" {ho.ppsubst S1} "with links" {pplinks L}, % HIDE
    complete-mapping S1 S1 M1 M2 F1 F2,
    print "# After complete-mapping, mmap are" {ppmappings M2} "with ho-subst" {ho.ppsubst S1}, % HIDE
    decompm M2 M2 S1 F2 F3.
%ENDSNIP

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% PRINTER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  type ppmapping mapping -> string -> o.
  ppmapping ((ovar N <-> mvar M Len)) S :- tex, !,
    S is {fo.ppuva N} ^ "," ^ {ho.ppuva M} ^ "," ^ {ppnat Len}.
  ppmapping ((ovar N <-> mvar M Len)) S :-
    S is {fo.ppuva N} ^ " -> " ^ {ho.ppuva M} ^ " (" ^ {ppnat Len} ^ ")".

  type ppmappings mmap -> list string -> o.
  ppmappings M Str :- map ppmapping M Str.

  macro @binder-names :- ["x", "y", "z", "w"].

  type pplink-latex-aux list string -> link -> list string -> string -> string -> string -> o.
  pplink-latex-aux [N|NS] (ho.abs F) [N|AS] OP B C :- !,
    pi x\ (ho.pp1 _ x N :- !) => pplink-latex-aux NS (F x) AS OP B C.
  pplink-latex-aux [] (ho.abs F) [A|AS] OP B C :- 
    pi x\ std.any->string x A, pplink-latex-aux [] (F x) AS OP B C.
  pplink-latex-aux BN (@val-link-eta X Y) [] "\\eta" B C :- ho.pp1 BN X B, ho.pp1 BN Y C.
  pplink-latex-aux BN (@val-link-llam X Y) [] "\\llambda" B C :- ho.pp1 BN X B, ho.pp1 BN Y C.

  type ppctx list string -> string -> o.
  ppctx [] "".
  ppctx [A] A :- !.
  ppctx [A|As] R :- ppctx As R1, R is A ^ "~" ^ R1.

  type pplink-latex link -> string -> o.
  pplink-latex L S :-
    pplink-latex-aux @binder-names L Ctx Eta-beta Left Right,
    S is Eta-beta ^ "," ^ {std.string.concat "~" Ctx} ^ "," ^ Left ^ "," ^ Right.

  type pplink link -> string -> o.
  pplink uvar _ :- halt "passed var otm pplink".
  pplink L S :- tex, !, pplink-latex L S.
  pplink (ho.abs F) S :- pi x\ std.any->string x N, pplink (F x) S1, S is N ^ " " ^ S1.
  pplink (@val-link-eta A B) S :- S is "|- " ^ {ho.pp A} ^ " =η= " ^ {ho.pp B}.
  pplink (@val-link-llam A B) S :- S is "|- " ^ {ho.pp A} ^ " =β= " ^ {ho.pp B}.

  type pplinks links -> list string -> o.
  pplinks L R :- map pplink L R.


  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TESTS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  type test-maybe-eta o.
  test-maybe-eta :-
    TESTS_OK = [
      "λx.(X (Y x) f)",
      "λx. λy. (Z (Y  x) (X  x  y))",
      "λx. λy. (Z (Y  (X x)) (X  (X x)  (X y)))",
      "λx.(f (X x) (X x))"
    ],
    TESTS_KO = [
      "λx.(f x x)",
      "λx.(f (g x) x)",
    ],
    forall1 test-maybe-eta-ok TESTS_OK,
    forall1 test-maybe-eta-ko TESTS_KO.

  type test-maybe-eta-ok string -> o.
  test-maybe-eta-ok S :- fo.parse S B,
    if (maybe-eta B []) true (print "Fail" S, fail).

  type test-maybe-eta-ko string -> o.
  test-maybe-eta-ko S :- fo.parse S B,
    if (maybe-eta B []) (print "Succeed" S, fail) true.
}