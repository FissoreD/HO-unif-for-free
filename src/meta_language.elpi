internal-test ho.test-unif-1.
internal-test ho.test-unif-2.
internal-test ho.test-unif-3.
internal-test ho.test-unif-4.
internal-test ho.test-unif-5.
internal-test ho.test-unif-6.
internal-test ho.test-unif-7.

namespace ho {
  shorten mem.{ set? , unset? , assign , new }.
  typeabbrev (mem A) (list (option A)).

%BEGIN

%SNIP: ho_subst
  kind inctx type -> type.                              
  type abs (mtm -> inctx A) -> inctx A.
  type val A -> inctx A.
  typeabbrev assignment (inctx mtm).
  typeabbrev subst (mem assignment).
%ENDSNIP

%SNIP: ho_tm
  kind mtm  type.
  type mapp list mtm -> mtm.
  type mlam (mtm -> mtm) -> mtm.
  type mcon string -> mtm.
  type muva addr -> list mtm -> mtm.
%ENDSNIP

pred fold2 (pred A, A1, B -> B), list A, list A1, B -> B.
fold2 _ [] [] A A.
fold2 F [X|XS] [Y|YS] A A1 :- F X Y A A0, fold2 F XS YS A0 A1.

%SNIP: heq
  pred (==m) mtm, mtm ->.                             
  X ==m Y :- (var X ; var Y), fatal "flex equal". % HIDE
  mcon C ==m mcon C.
  mapp A ==m mapp B :- forall2 (==m) A B.
  mlam F ==m mlam G :- pi x\ x ==m x => F x ==m G x.
  muva N A ==m muva N B :- forall2 (==m) A B.
%ENDSNIP: heq

%SNIP: ue_type
  % [unif T1 T2 SOld SNew] check if T1 and T2 unify looking into SOld. SNew is the final substution
  pred (==l) mtm, mtm, subst -> subst.
%ENDSNIP
  (A ==l B) C _ :- (var A; var B; var C), halt "Passed var to unif". %HIDE
  % congruence
  (mcon C ==l mcon C) S S.
  (mapp L1 ==l mapp L2) S S1 :- fold2 (==l) L1 L2 S S1.
  (mlam F1 ==l mlam F2) S S1 :- 
    pi x\ (pi S\ (x ==l x) S S) => (F1 x ==l F2 x) S S1.
  % set variables
  (muva N Args ==l T) S S1 :- 
    set? N S F,!, move F Args T1, (T1 ==l T) S S1.
  (T ==l muva N Args) S S1 :- 
    set? N S F,!, move F Args T1, (T ==l T1) S S1.
  % flex-flex
  (muva M A1 ==l muva N A2) S1 S2 :- !, 
    pattern-fragment A1, pattern-fragment A2, 
    prune! M A1 N A2 S1 S2.
  (muva N Args ==l T) S S1 :- not_occ N S T, pattern-fragment Args, 
    bind T Args T1, assign N S T1 S1.
  % variable assigment
  (T ==l muva N Args) S S1 :- not_occ N S T, pattern-fragment Args, 
    bind T Args T1, assign N S T1 S1.
  (N ==l N) S S :- name N. % HIDE since we may call ==l under some abs...
  % Note: eta & beta for unification is not allowed in ML over terms of the OL

  % Note: We suppose the scopes to always be in PF
  type prune! addr -> list mtm -> addr -> 
              list mtm -> subst -> subst -> o.
  /* no pruning needed */               
  prune! N A  N A  S S :- !.
  prune! M A  N A  S1 S2 :- !, bind (muva M A) A Ass, 
    assign N S1 Ass S2.
  /* prune different arguments */
  prune! N A1 N A2 S1 S3 :- !,
    std.assert!(len A1 {len A2}) "Not typechecking", !, % HIDE
    new S1 W S2, prune-same-variable W A1 A2 [] Ass,
    assign N S2 Ass S3.
  /* prune to the intersection of scopes */
  prune! N A1 M A2 S1 S4 :- !,
    new S1 W S2, prune-diff-variables W A1 A2 Ass1 Ass2, 
    assign N S2 Ass1 S3,
    assign M S3 Ass2 S4. 

  type prune-same-variable addr -> list mtm -> list mtm -> 
                            list mtm -> assignment -> o.
  prune-same-variable N [] [] ACC (val (muva N Args)) :- 
    rev ACC Args.
  prune-same-variable N [X|XS] [X|YS] ACC (abs F) :- 
    pi x\ prune-same-variable N XS YS [x|ACC] (F x).
  prune-same-variable N [_|XS] [_|YS] ACC (abs F) :- 
    pi x\ prune-same-variable N XS YS ACC (F x).

  type permute list nat -> list mtm -> list mtm -> o.
  permute [] _ [].
  permute [P|PS] Args [T|TS] :-
    nth P Args T,
    permute PS Args TS.

  type build-perm-assign addr -> list mtm -> list bool -> 
                      list nat -> assignment -> o.
  build-perm-assign N ArgsR [] Perm (val (muva N PermutedArgs)) :- 
    rev ArgsR Args, permute Perm Args PermutedArgs.
  build-perm-assign N Acc [tt|L] Perm (abs T) :- 
    pi x\ build-perm-assign N [x|Acc] L Perm (T x).
  build-perm-assign N Acc [ff|L] Perm (abs T) :- 
    pi x\ build-perm-assign N Acc L Perm (T x).

  type keep list A -> A -> bool -> o.
  keep L A tt :- mem L A, !.
  keep _ _ ff.

  type prune-diff-variables addr -> list mtm -> list mtm -> 
                            assignment -> assignment -> o.
  prune-diff-variables N Args1 Args2 Ass1 Ass2 :-
    map (keep Args2) Args1 Bits1, 
    map (keep Args1) Args2 Bits2,
    filter Args1 (mem Args2) ToKeep1,
    filter Args2 (mem Args1) ToKeep2,
    map (index ToKeep1) ToKeep1 IdPerm,
    map (index ToKeep1) ToKeep2 Perm21,
    build-perm-assign N [] Bits1 IdPerm Ass1,
    build-perm-assign N [] Bits2 Perm21 Ass2.

  type beta mtm -> list mtm -> mtm -> o.
  beta A [] A :- !.
  beta (mlam Bo) [H | L] R :- beta (Bo H) L R1, beta-aux R1 R.
  beta (mapp A) L (mapp X) :- append A L X.
  % beta (muva N A) L (muva N A') :- !, halt "XXX", append A L A'. % HIDE
  beta (mcon H) L (mapp [mcon H | L]).
  beta X L (mapp[X|L]) :- name X.

  type beta-aux mtm -> mtm -> o.
  beta-aux (mapp [HD|TL]) R :- !, beta HD TL R.
  beta-aux A A. 

  /* occur check for N before crossing a functor */
  type not_occ  addr -> subst -> mtm -> o.
  not_occ N H T :- (var N; var H; var T), halt "Invalid call to not_occ". % HIDE
  not_occ N S (muva M Args) :- set? M S F, 
    move F Args T, not_occ N S T.
  not_occ N S (muva M Args) :- unset? M S, not (M = N),
    forall1 (not_occ_aux N S) Args.
  not_occ _ _ (mcon _).
  not_occ N S (mapp L) :- not_occ_aux N S (mapp L).
  /* Note: mlam is a functor for the meta language! */
  not_occ N S (mlam L) :- pi x\ not_occ_aux N S (L x).
  not_occ _ _ X :- name X.
  /* finding N is ok */
  not_occ N _ (muva N _).

  /* occur check for X after crossing a functor */
  type not_occ_aux addr -> subst -> mtm -> o.
  not_occ_aux N H T :- (var N; var H; var T), halt "Invalid call to not_occ_aux". % HIDE
  not_occ_aux N S (muva M _) :- unset? M S, not (N = M).
  not_occ_aux N S (muva M Args) :- set? M S F, 
    move F Args T, not_occ_aux N S T.
  not_occ_aux N S (mapp L) :- forall1 (not_occ_aux N S) L.
  not_occ_aux N S (mlam F) :- pi x\ not_occ_aux N S (F x).
  not_occ_aux _ _ (mcon _).
  not_occ_aux _ _ X :- name X.
  /* finding N is ko, hence no rule */
  
  /* copy T T' vails if T contains a free variable, i.e. it
     performs scope checking for bind */
  type copy mtm -> mtm -> o.
  copy (mcon C)   (mcon C).
  copy (mapp L)   (mapp L') :- map copy L L'.
  copy (mlam T)   (mlam T') :- pi x\ copy x x => copy (T x) (T' x).
  copy (muva A L) (muva A L') :- map copy L L'.

  type bind mtm -> list mtm -> assignment -> o.
  bind T [] (val T') :- copy T T'.
  bind T [X | TL] (abs T') :- pi x\ copy X x => bind T TL (T' x).

%SNIP: deref
  pred deref subst, mtm -> mtm.                   
  deref S X _ :- (var S; var X), halt "flex deref". % HIDE
  deref _ (mcon C) (mcon C).
  deref S (mapp A) (mapp B) :- map (deref S) A B.
  deref S (mlam F) (mlam G) :-
    pi x\ deref S x x => deref S (F x) (G x).
  deref S (muva N L) R :- set? N S A,
    move A L T, deref S T R.
  deref S (muva N A) (muva N B) :- unset? N S,
    map (deref S) A B.
  deref _ N         N          :- name N. % HIDE
%ENDSNIP

%SNIP: move
  pred move assignment, list mtm -> mtm.
  move (abs Bo) [H|L] R :- move (Bo H) L R.
  move (val A)  [] A :- !.
                        % !. % to ease traces?
  % move (val (muva N A)) L     (muva N X) :- append A L X.
  move (abs A)         []    _ :- !, fatal "Invalid move call: too few args for abs" A. % HIDE
  move A               L    _ :- !, fatal "Invalid move call:" A L. % HIDE

%ENDSNIP

  type deref-assmt subst -> assignment -> assignment -> o.
  deref-assmt S (abs T) (abs R) :- pi x\ deref-assmt S (T x) (R x).
  deref-assmt S (val T) (val R) :- deref S T R.
%END

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% PRINTER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  macro @binder-names :- ["x", "y", "z", "w"].

  type lambda string -> o.
  lambda "\\lambda " :- tex, !.
  lambda "λ".

  type appsep string -> o.
  appsep "\\appsep " :- tex, !.
  appsep " ".

  type print_uva_scope mem.addr -> string -> string -> o.
  print_uva_scope N S R :- tex, !, R is {ppuva N} ^ "_{" ^ S ^ "}".
  print_uva_scope N S R :- R is "`" ^ {ppuva N} ^ " " ^ S ^ "'".

  type pp1 list string -> mtm -> string -> o.
  type pp mtm -> string -> o.
  pp T S :- pp1 @binder-names T S.
  pp1 BN (mapp [mlam F|L]) S :- !, pp1 BN (mlam F) H, std.string.concat {appsep} {std.map L (pp1 BN)} X, S is "((" ^ H ^ ") " ^ X ^ ")".
  pp1 BN (mapp L) S :- !, std.string.concat {appsep} {std.map L (pp1 BN)} X, S is "(" ^ X ^ ")".
  pp1 _ (mcon S) S :- !.
  pp1 [X|XS] (mlam F) S :- !, pi x\ (pp1 _ x X :- !) => pp1 XS (F x) S1, S is {lambda} ^ X ^ "." ^ S1.
  pp1 [] (mlam F) S :- !, pi x\ pp1 _ x X, pp1 [] (F x) S1, S is {lambda} ^ X ^ "." ^ S1.
  pp1 _ (muva N []) S :- !, S is {ppuva N}.
  pp1 BN (muva N L) S :- !, std.map L (pp1 BN) L1, std.string.concat " " L1 X, !, print_uva_scope N X S.
  pp1 _ X S :- name X, !, std.any->string X S.
  pp1 _ _ "ERROR".

  type ppuva addr -> string -> o.
  ppuva N S :- 
    mem.ppaddr N M,
    ppuva.aux M S.
  ppuva.aux "0" "A" :- !.
  ppuva.aux "1" "B" :- !.
  ppuva.aux "2" "C" :- !.
  ppuva.aux "3" "D" :- !.
  ppuva.aux "4" "E" :- !.
  ppuva.aux "5" "F" :- !.
  ppuva.aux "6" "G" :- !.
  ppuva.aux "7" "H" :- !.
  ppuva.aux "8" "I" :- !.
  ppuva.aux "9" "J" :- !.
  ppuva.aux N S :- S is "E" ^ N.

  type ppsubst subst -> list string -> o.
  ppsubst L S :- mem.pp L ppuva ppass S.

  type ppass-tex list string -> assignment -> list string -> string -> o.
  ppass-tex [A|As] (abs F) L S :- !, pi x\ (pp1 _ x A :- !) => ppass-tex As (F x) [A | L] S.
  ppass-tex [] (abs F) L S :- pi x\ ppass-tex [] (F x) [{std.any->string x} | L] S.
  ppass-tex BN (val T) L S :- 
    S is "_{" ^ {std.string.concat "~" L} ^ "} \\mapsto " ^ {pp1 BN T}. 

  type ppass assignment -> string -> o.
  ppass A S :- tex, !, ppass-tex @binder-names A [] S.
  ppass A S :- ppass1 @binder-names A S.

  type ppass1 list string -> assignment -> string -> o.
  ppass1 [] (abs F) S :- pi x\ std.any->string x N, ppass1 [] (F x) S1, S is N ^ " " ^ S1.
  ppass1 [X|XS] (abs F) S :- pi x\ (pp1 _ x X :- !) => ppass1 XS (F x) S1, S is X ^ " " ^ S1.
  ppass1 XS (val T) S :- S is ":= " ^ {pp1 XS T}.

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TESTS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  macro @mem-muva N S :- muva (mem.addr N) S.

  type test-unif-1 o.
  type test-unif-2 o.
  type test-unif-3 o.
  type test-unif-4 o.
  type test-unif-5 o.
  type test-unif-6 o.
  type test-unif-7 o.

  test-unif-1 :- pi x\
    (@mem-muva z [x] ==l @mem-muva (s z) []) [none, none] L,
    Z = (abs x\ val (muva X [])),
    SZ = val (muva X []),
    L = [some Z, some SZ|_].

  test-unif-2 :- pi x y\
    (@mem-muva z [x, y] ==l @mem-muva (s z) [y]) [none, none] L,
    Z = (abs x\ abs y\ val (muva X [y])),
    SZ = (abs x\ val (muva X [x])),
    L = [some Z, some SZ|_].

  test-unif-3 :- pi x y w\
    (@mem-muva z [x, y] ==l @mem-muva (s z) [x, w, y]) [none, none] L,
    Z = (abs x\ abs y\ val (muva X [x, y])),
    SZ = (abs x\ abs y\ abs z\ val (muva X [x, z])),
    L = [some Z, some SZ|_].

  test-unif-4 :- pi x y\ 
    (@mem-muva z [x, y] ==l @mem-muva (s z) [y, x]) [none, none] L,
    Z = (abs x\ abs y\ val (muva X [x, y])),
    SZ = (abs x\ abs y\ val (muva X [y, x])),
    L = [some Z, some SZ|_].

  test-unif-5 :- pi x y zz w\
    (@mem-muva z [x, w, y] ==l @mem-muva (s z) [y, zz, w]) [none, none] L,
    Z = (abs c0\ abs c1\ abs c2\ val (muva X [c1, c2])),
    SZ = (abs c0\ abs c1\ abs c2\ val (muva X [c2, c0])),
    L = [some Z, some SZ|_].

  test-unif-6 :- pi x y zz w\
    (@mem-muva (s z) [y, zz, w] ==l @mem-muva z [x, w, y]) [none, none] L,
    Z = (abs c0\ abs c1\ abs c2\ val (muva X [c2, c1])),
    SZ = (abs c0\ abs c1\ abs c2\ val (muva X [c0, c2])),
    L = [some Z, some SZ|_].

  test-unif-7 :- pi x y w zz\
    (@mem-muva z [x, y, w] ==l @mem-muva z [zz, y, x]) [none] L,
    L = [some (abs x\ abs y\ abs z\ val (muva _ [y])) | _].
}
